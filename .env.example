# ResumeForge environment variables
# Copy this file to .env.local and paste your own free keys there.
# NEVER commit .env.local or share your keys.

# Google Gemini (primary AI) — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# Groq (fallback AI) — free key from https://console.groq.com/keys
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE

# Development-only mock mode (sample AI answers, no quota used). Ignored in production builds.
MOCK_AI=false

# Optional: URL for the "Review it in AdmitLens" button. Leave empty to hide the button.
NEXT_PUBLIC_ADMITLENS_URL=
